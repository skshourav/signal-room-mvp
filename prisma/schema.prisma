generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum Side {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

/** NEW: prop firm lifecycle */
enum ChallengeStatus {
  ACTIVE
  PAUSED
  PASSED
}

enum ChallengePhase {
  PHASE1
  PHASE2
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /** NEW: Option 1 (active account selection) */
  activeAccountId String?
  activeAccount   ClientAccount? @relation("UserActiveAccount", fields: [activeAccountId], references: [id])

  accounts  ClientAccount[]
}

model ClientAccount {
  id              String   @id @default(cuid())
  userId          String
  name            String   @default("Main")
  startingBalance Float
  currentEquity   Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /** NEW: prop challenge config (fixed drawdown + 2 phases) */
  challengeStatus     ChallengeStatus @default(ACTIVE)
  challengePhase      ChallengePhase  @default(PHASE1)

  /** Stored as percent numbers like 8, 5, 10 */
  phase1TargetPct     Float
  phase2TargetPct     Float
  maxLossPct          Float

  phase2StartedAt     DateTime?
  phase2StartEquity   Float?
  pausedAt            DateTime?
  passedAt            DateTime?

  user         User        @relation(fields: [userId], references: [id])
  riskProfile  RiskProfile?
  presences    Presence[]
  deliveries   SignalDelivery[]
  trades       Trade[]

  /** Relation back to User’s activeAccount */
  activeUsers User[] @relation("UserActiveAccount")
}

model RiskProfile {
  id          String   @id @default(cuid())
  accountId   String   @unique
  riskPercent Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account ClientAccount @relation(fields: [accountId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  name      String
  timezone  String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signals   Signal[]
  presences Presence[]
}

model Presence {
  id          String   @id @default(cuid())
  sessionId   String
  accountId   String
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  lastSeenAt  DateTime @default(now())

  session Session       @relation(fields: [sessionId], references: [id])
  account ClientAccount @relation(fields: [accountId], references: [id])

  @@index([sessionId, lastSeenAt])
}

model Signal {
  id         String   @id @default(cuid())
  sessionId  String
  symbol     String
  side       Side
  timeframe  String
  signalTime DateTime
  sl         Float
  tp         Float
  createdBy  String
  createdAt  DateTime @default(now())

  session    Session  @relation(fields: [sessionId], references: [id])
  deliveries SignalDelivery[]
  trades     Trade[]
}

model SignalDelivery {
  id          String   @id @default(cuid())
  signalId    String
  accountId   String
  deliveredAt DateTime @default(now())
  viewedAt    DateTime?

  signal   Signal        @relation(fields: [signalId], references: [id])
  account  ClientAccount @relation(fields: [accountId], references: [id])

  @@unique([signalId, accountId])
}

model Trade {
  id         String      @id @default(cuid())
  accountId  String
  signalId   String
  status     TradeStatus @default(OPEN)

  entryTime  DateTime
  entryPrice Float
  sl         Float
  tp         Float
  lotSize    Float

  equityAtEntry Float?
  riskAmount    Float?

  exitTime   DateTime?
  exitPrice  Float?
  pnlR       Float?
  pnlMoney   Float?

  createdAt  DateTime @default(now())

  account ClientAccount @relation(fields: [accountId], references: [id])
  signal  Signal        @relation(fields: [signalId], references: [id])

  @@unique([signalId, accountId])
}

model Candle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?

  @@unique([symbol, timeframe, time])
}
